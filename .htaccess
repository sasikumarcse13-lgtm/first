# CollegeShine React SPA - Apache / Hostinger
RewriteEngine On

# Keep real files and directories accessible.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Legacy flat course URLs are redirected to the hierarchical canonical URLs.
RewriteRule ^bachelor-of-dental-surgery-bds/?$ /course/bds/bachelor-of-dental-surgery-bds/ [R=301,L,NE]
