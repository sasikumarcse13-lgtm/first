# Use Hostinger Environment Variables in production. Do not commit real secrets.
DB_HOST=YOUR_DATABASE_HOST
DB_PORT=3306
DB_NAME=YOUR_DATABASE_NAME
DB_USER=YOUR_DATABASE_USER
DB_PASSWORD=YOUR_NEW_DATABASE_PASSWORD
PORT=5000
NODE_ENV=production
FRONTEND_ORIGIN=https://YOUR_TEMPORARY_DOMAIN
CORS_ORIGIN=https://YOUR_TEMPORARY_DOMAIN
BLOG_ADMIN_TOKEN=GENERATE_A_LONG_RANDOM_SECRET
# Keep the canonical site origin on the final domain. Set noindex=true while testing on a temporary domain.
VITE_SITE_ORIGIN=https://collegeshine.com
VITE_NOINDEX_ALL=true
