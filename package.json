{
  "name": "collegeshine-seo-pages",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/generate-seo-html.mjs",
    "preview": "vite preview",
    "sitemap": "node scripts/generate-sitemap.mjs",
    "prebuild": "node scripts/generate-sitemap.mjs",
    "audit": "node scripts/audit-routes.mjs",
    "validate": "node scripts/validate-source.mjs",
    "start": "node server/server.js",
    "server": "node server/server.js",
    "seo:audit": "node scripts/seo-audit.mjs",
    "dev:full": "concurrently -k \"node server/server.js\" \"vite\"",
    "server:dev": "node --watch server/server.js"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "vite": "latest",
    "react": "latest",
    "react-dom": "latest",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "multer": "^2.0.2",
    "mysql2": "^3.14.3",
    "dotenv": "^16.4.7",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {}
}
